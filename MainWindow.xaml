<Window x:Class="MediaControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaControl" Width="470" Height="254" MinWidth="470" MinHeight="254"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#078BEA"/>
        <SolidColorBrush x:Key="White" Color="#F6F7F8"/>
        <SolidColorBrush x:Key="Muted" Color="#AEB1B5"/>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.62"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="15,0,0,0">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#454648"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#37383B"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.62"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BindingButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#383A3D"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Width" Value="116"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="MediaSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Slider">
                    <Grid Height="19">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="2" Background="{StaticResource Blue}" BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="10" Height="10" Background="{StaticResource Blue}" BorderThickness="0">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="2" Background="#777A7E" BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Blue}" BorderThickness="1" Background="#2D2E31">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#08090B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Image Width="19" Height="19" HorizontalAlignment="Left" Margin="11,0,0,0" Source="/Assets/Lucide/png/play.png"/>
                <TextBlock Text="PotPlayer" Foreground="{StaticResource White}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="38,0,0,0"/>
                <TextBlock Text="CONTROLE DE MÍDIA" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="112,0,0,0"/>
                <Button x:Name="PauseHotkeysButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,69,0" Width="77" Height="23" Background="#12669F" FontSize="9" FontWeight="Bold" Content="ATIVO" Click="PauseHotkeys_Click" ToolTip="F9 · Pausar atalhos"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Width="31" Height="30" Click="Minimize_Click" ToolTip="Minimizar para a bandeja">
                        <Image Source="/Assets/Lucide/png/minus.png" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Width="31" Height="30" Click="Close_Click" ToolTip="Fechar">
                        <Image Source="/Assets/Lucide/png/x.png" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Background="#171819" Margin="0,0,0,0">
                    <Button x:Name="NavPlayback" Style="{StaticResource NavButton}" Background="#505154" Click="NavPlayback_Click" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/play.png" Width="23" Height="23"/><TextBlock Text="Reprodução" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTracks" Style="{StaticResource NavButton}" Click="NavTracks_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/list-music.png" Width="23" Height="23"/><TextBlock Text="Faixas" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavVolume" Style="{StaticResource NavButton}" Click="NavVolume_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/volume-2.png" Width="23" Height="23"/><TextBlock Text="Volume" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavPrograms" Style="{StaticResource NavButton}" Click="NavPrograms_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/monitor.png" Width="23" Height="23"/><TextBlock Text="Programas" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavHotkeys" Style="{StaticResource NavButton}" Click="NavHotkeys_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/keyboard.png" Width="23" Height="23"/><TextBlock Text="Atalhos" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" Click="NavGeneral_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/settings-2.png" Width="23" Height="23"/><TextBlock Text="Geral" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="1" Background="#2D2E31">
                    <Canvas x:Name="PlaybackPage">
                        <TextBlock Canvas.Left="24" Canvas.Top="12" Text="POTPLAYER" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="TrackTitle" Canvas.Left="24" Canvas.Top="31" Width="201" Text="Faixa atual" TextTrimming="CharacterEllipsis" Foreground="{StaticResource White}" FontSize="15" FontWeight="Bold" ToolTip="Faixa atual"/>
                        <Border Canvas.Left="237" Canvas.Top="18" Width="60" Height="20" CornerRadius="10" Background="#253C4C">
                            <TextBlock x:Name="PlaybackBadge" Text="TOCANDO" Foreground="#65BDFF" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Slider x:Name="ProgressSlider" Canvas.Left="24" Canvas.Top="65" Width="264" Height="19" Minimum="0" Maximum="100" Value="21" Style="{StaticResource MediaSlider}" PreviewMouseLeftButtonDown="ProgressSlider_MouseDown" PreviewMouseLeftButtonUp="ProgressSlider_MouseUp"/>
                        <TextBlock x:Name="CurrentTimeText" Canvas.Left="24" Canvas.Top="85" Text="00:42" Foreground="{StaticResource Muted}" FontSize="9"/>
                        <TextBlock x:Name="TotalTimeText" Canvas.Left="229" Canvas.Top="85" Width="59" Text="03:18" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="9"/>

                        <Button Canvas.Left="19" Canvas.Top="103" Width="40" Height="40" Style="{StaticResource CircleButton}" Click="SeekBackward_Click" ToolTip="Voltar 5 segundos">
                            <Image Source="/Assets/Lucide/png/rotate-ccw.png" Width="27" Height="27"/>
                        </Button>
                        <Button Canvas.Left="67" Canvas.Top="101" Width="44" Height="44" Style="{StaticResource CircleButton}" Click="Previous_Click" ToolTip="Faixa anterior">
                            <Image Source="/Assets/Lucide/png/skip-back.png" Width="29" Height="29"/>
                        </Button>
                        <Button Canvas.Left="126" Canvas.Top="91" Width="64" Height="64" Style="{StaticResource CircleButton}" Background="{StaticResource Blue}" Click="PlayPause_Click" ToolTip="Pausar ou continuar">
                            <Image x:Name="PlayPauseIcon" Source="/Assets/Lucide/png/pause.png" Width="39" Height="39"/>
                        </Button>
                        <Button Canvas.Left="205" Canvas.Top="101" Width="44" Height="44" Style="{StaticResource CircleButton}" Click="Next_Click" ToolTip="Próxima faixa">
                            <Image Source="/Assets/Lucide/png/skip-forward.png" Width="29" Height="29"/>
                        </Button>
                        <Button Canvas.Left="257" Canvas.Top="103" Width="40" Height="40" Style="{StaticResource CircleButton}" Click="SeekForward_Click" ToolTip="Avançar 5 segundos">
                            <Image Source="/Assets/Lucide/png/rotate-cw.png" Width="27" Height="27"/>
                        </Button>
                        <TextBlock Canvas.Left="16" Canvas.Top="153" Width="47" Text="VOLTAR" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="8"/>
                        <TextBlock Canvas.Left="69" Canvas.Top="153" Width="40" Text="ANT." TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="8"/>
                        <TextBlock x:Name="PlayPauseCaption" Canvas.Left="127" Canvas.Top="153" Width="62" Text="PAUSAR" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="8"/>
                        <TextBlock Canvas.Left="207" Canvas.Top="153" Width="40" Text="PRÓX." TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="8"/>
                        <TextBlock Canvas.Left="254" Canvas.Top="153" Width="47" Text="AVANÇAR" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="8"/>
                        <Rectangle Canvas.Left="19" Canvas.Top="176" Width="278" Height="1" Fill="#47494D"/>
                        <Button Canvas.Left="23" Canvas.Top="187" Width="31" Height="31" Style="{StaticResource FlatButton}" Click="Mute_Click" ToolTip="Silenciar ou restaurar volume">
                            <Image x:Name="PlaybackVolumeIcon" Source="/Assets/Lucide/png/volume-2.png" Width="25" Height="25"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Canvas.Left="59" Canvas.Top="194" Width="191" Height="19" Minimum="0" Maximum="100" Value="65" Style="{StaticResource MediaSlider}" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValueText" Canvas.Left="260" Canvas.Top="193" Width="35" Text="65%" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </Canvas>

                    <Grid x:Name="TracksPage" Visibility="Collapsed" Margin="18,13,18,12">
                        <StackPanel>
                            <TextBlock Text="FAIXAS" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="Navegar pela reprodução" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,11"/>
                            <Button Style="{StaticResource FlatButton}" Tag="4" Background="#37383B" Height="48" Click="Previous_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/skip-back.png" Width="25" Height="25"/><TextBlock Text="Faixa anterior" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Tag="4" Background="#37383B" Height="48" Click="Next_Click" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal"><Image Source="/Assets/Lucide/png/skip-forward.png" Width="25" Height="25"/><TextBlock x:Name="NextTrackButtonLabel" Text="Próxima faixa  ·  F1" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                            </Button>
                            <TextBlock Text="Use os botões ou os atalhos globais." Foreground="{StaticResource Muted}" FontSize="10"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="VolumePage" Visibility="Collapsed" Margin="18,13,18,12">
                        <StackPanel>
                            <TextBlock Text="VOLUME" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="Volume do PotPlayer" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,14"/>
                            <TextBlock x:Name="VolumePageValueText" Text="65%" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                            <Slider x:Name="VolumePageSlider" Minimum="0" Maximum="100" Value="65" Style="{StaticResource MediaSlider}" ValueChanged="VolumeSlider_ValueChanged" Margin="8,0,8,11"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource FlatButton}" Tag="4" Background="#37383B" Height="39" Click="VolumeDown_Click" ToolTip="Diminuir volume">
                                    <Image Source="/Assets/Lucide/png/minus.png" Width="21" Height="21"/>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Tag="4" Background="#37383B" Height="39" Click="Mute_Click" Margin="6,0" ToolTip="Silenciar ou restaurar">
                                    <Image x:Name="VolumePageMuteIcon" Source="/Assets/Lucide/png/volume-x.png" Width="21" Height="21"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Tag="4" Background="#37383B" Height="39" Click="VolumeUp_Click" ToolTip="Aumentar volume">
                                    <Image Source="/Assets/Lucide/png/plus.png" Width="21" Height="21"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="VolumeHotkeyHint" Text="Numpad − / + ajustam de qualquer janela" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Canvas x:Name="ProgramsPage" Visibility="Collapsed" Margin="15,7,15,7">
                        <TextBlock Canvas.Left="0" Canvas.Top="0" Text="PROGRAMAS" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="17" Text="Onde os atalhos funcionam" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <Button x:Name="AllProgramsButton" Canvas.Left="0" Canvas.Top="43" Width="92" Height="27" Style="{StaticResource FlatButton}" Background="{StaticResource Blue}" Click="AllPrograms_Click" Content="Todos" FontSize="11"/>
                        <Button x:Name="OnlyListButton" Canvas.Left="98" Canvas.Top="43" Width="185" Height="27" Style="{StaticResource FlatButton}" Background="#37383B" Click="OnlyList_Click" Content="Somente lista" FontSize="11"/>
                        <ListBox x:Name="ProgramList" Canvas.Left="0" Canvas.Top="77" Width="283" Height="70" Background="#242528" Foreground="White" BorderBrush="#505154" BorderThickness="1" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#404347"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#125E91"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="ProgramEmptyText" Canvas.Left="31" Canvas.Top="102" Text="Nenhum programa cadastrado" Foreground="{StaticResource Muted}" FontSize="10" IsHitTestVisible="False"/>
                        <Button Canvas.Left="0" Canvas.Top="153" Width="103" Height="28" Style="{StaticResource FlatButton}" Background="#37383B" Click="AddOpenWindow_Click" Content="Janela aberta" FontSize="10"/>
                        <Button Canvas.Left="108" Canvas.Top="153" Width="97" Height="28" Style="{StaticResource FlatButton}" Background="#37383B" Click="ChooseExecutable_Click" Content="Escolher arquivo" FontSize="10"/>
                        <Button Canvas.Left="210" Canvas.Top="153" Width="73" Height="28" Style="{StaticResource FlatButton}" Background="#37383B" Click="RemoveProgram_Click" Content="Remover" FontSize="10"/>
                        <TextBlock x:Name="ProgramStatusText" Canvas.Left="0" Canvas.Top="189" Width="283" Text="Atalhos disponíveis em todos os programas" Foreground="{StaticResource Muted}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                    </Canvas>

                    <Grid x:Name="HotkeyPage" Visibility="Collapsed" Margin="15,3,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/>
                            <RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Próxima faixa" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="NextBinding" Grid.Row="0" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="F1"/>
                        <TextBlock Grid.Row="1" Text="Pausar / continuar" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="PauseBinding" Grid.Row="1" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="F2"/>
                        <TextBlock Grid.Row="2" Text="Aumentar volume" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="VolumeUpBinding" Grid.Row="2" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="Numpad +"/>
                        <TextBlock Grid.Row="3" Text="Diminuir volume" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="VolumeDownBinding" Grid.Row="3" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="Numpad -"/>
                        <TextBlock Grid.Row="4" Text="Voltar 5s" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="SeekBackBinding" Grid.Row="4" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="←"/>
                        <TextBlock Grid.Row="5" Text="Avançar 5s" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="SeekForwardBinding" Grid.Row="5" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="→"/>
                        <TextBlock Grid.Row="6" Text="Pausar / reativar atalhos" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="PauseHotkeysBinding" Grid.Row="6" Click="Binding_Click" Style="{StaticResource BindingButton}" HorizontalAlignment="Right" Content="F9"/>
                        <Grid Grid.Row="7" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="73"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HintText" Grid.Column="0" Text="Clique na tecla para alterar" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Click="Defaults_Click" Content="Padrão" FontSize="11" Height="28"/>
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Background="#0877C7" Click="Apply_Click" Content="Aplicar" FontSize="11" Height="28"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="GeneralPage" Visibility="Collapsed" Margin="18,13,18,12">
                        <StackPanel>
                            <TextBlock Text="GERAL" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="Preferências do aplicativo" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,15"/>
                            <TextBlock Text="Idioma" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Escolha o idioma da interface" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="EnglishButton" Grid.Column="0" Style="{StaticResource FlatButton}" Background="{StaticResource Blue}" Height="39" Content="English" Click="English_Click"/>
                                <Button x:Name="PortugueseButton" Grid.Column="2" Style="{StaticResource FlatButton}" Background="#37383B" Height="39" Content="Português" Click="Portuguese_Click"/>
                            </Grid>
                            <TextBlock Text="A alteração é aplicada imediatamente." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PauseHotkeyHelpText" Text="F9 pausa ou reativa os atalhos em qualquer programa." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
