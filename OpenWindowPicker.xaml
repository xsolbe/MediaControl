<Window x:Class="MediaControl.OpenWindowPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar janela aberta" Width="470" Height="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F6F7F8"/>
            <Setter Property="Background" Value="#393B3F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#343639" BorderBrush="#45484C" BorderThickness="1" CornerRadius="5" Padding="11,8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#41454A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#173E5A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#078BEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#078BEA" BorderThickness="1" Background="#2D2E31">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="76"/>
                <RowDefinition Height="29"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#08090B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/Lucide/png/monitor.png" Width="19" Height="19"/>
                    <TextBlock Text="Adicionar janela aberta" Foreground="#F6F7F8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource ActionButton}" Background="Transparent" HorizontalAlignment="Right" Width="37" Height="36" Click="Cancel_Click" ToolTip="Fechar">
                    <Image Source="/Assets/Lucide/png/x.png" Width="17" Height="17"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="16,15,16,9">
                <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="9"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Escolha um programa em execução" Foreground="#F6F7F8" FontSize="12" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Background="#202225" BorderBrush="#50545A" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/Lucide/png/search.png" Width="17" Height="17" Opacity="0.75"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="#F6F7F8" BorderThickness="0" CaretBrush="#078BEA" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Buscar janela ou executável" Foreground="#85898E" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="17,0,17,0">
                <TextBlock Text="JANELAS ABERTAS" Foreground="#078BEA" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Foreground="#AEB1B5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Margin="16,0,16,0">
                <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0" Foreground="#F6F7F8" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource WindowItem}" SelectionChanged="WindowList_SelectionChanged" MouseDoubleClick="WindowList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding ExecutablePath}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="4" Background="#222D36" VerticalAlignment="Center">
                                    <Image Source="/Assets/Lucide/png/monitor.png" Width="17" Height="17"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="#F6F7F8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding ExecutableName}" Foreground="#AEB1B5" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="Nenhuma janela corresponde à busca" Foreground="#AEB1B5" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="4" Background="#252629" Margin="0,11,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="91"/><ColumnDefinition Width="8"/><ColumnDefinition Width="102"/></Grid.ColumnDefinitions>
                <TextBlock Text="Selecione uma janela para adicionar" Foreground="#AEB1B5" FontSize="10" VerticalAlignment="Center" Margin="17,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Cancelar" Height="30" Click="Cancel_Click"/>
                <Button x:Name="AddButton" Grid.Column="3" Style="{StaticResource ActionButton}" Background="#078BEA" Content="Adicionar" Height="30" Margin="0,0,16,0" IsEnabled="False" Click="Add_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
