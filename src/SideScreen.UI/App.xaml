<Application x:Class="SideScreen.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SideScreen.UI"
             xmlns:vm="clr-namespace:SideScreen.UI.ViewModels"
             xmlns:views="clr-namespace:SideScreen.UI.Views"
             xmlns:conv="clr-namespace:SideScreen.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- ViewModel -> View (navegação automática) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
                <views:PlayersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}">
                <views:ShortcutsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                <views:DisplayView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
