<!-- SideScreen Design System v1 — dark utilitário Windows. Sem neon, sem cards, sem gradiente. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ TOKENS ============ -->
    <Color x:Key="DsBg">#070707</Color>
    <Color x:Key="DsBg2">#0D0D0D</Color>
    <Color x:Key="DsSidebar">#151515</Color>
    <Color x:Key="DsSidebarActive">#303030</Color>
    <Color x:Key="DsMain">#0A0A0A</Color>
    <Color x:Key="DsInput">#111111</Color>
    <Color x:Key="DsHover">#202020</Color>
    <Color x:Key="DsText">#F2F2F2</Color>
    <Color x:Key="DsText2">#A0A0A0</Color>
    <Color x:Key="DsTextDis">#666666</Color>
    <Color x:Key="DsAccent">#1689E8</Color>
    <Color x:Key="DsAccentHover">#2798F5</Color>
    <Color x:Key="DsAccentPress">#0D72C7</Color>

    <SolidColorBrush x:Key="DsBgBrush" Color="{StaticResource DsBg}"/>
    <SolidColorBrush x:Key="DsBg2Brush" Color="{StaticResource DsBg2}"/>
    <SolidColorBrush x:Key="DsSidebarBrush" Color="{StaticResource DsSidebar}"/>
    <SolidColorBrush x:Key="DsSidebarActiveBrush" Color="{StaticResource DsSidebarActive}"/>
    <SolidColorBrush x:Key="DsMainBrush" Color="{StaticResource DsMain}"/>
    <SolidColorBrush x:Key="DsInputBrush" Color="{StaticResource DsInput}"/>
    <SolidColorBrush x:Key="DsHoverBrush" Color="{StaticResource DsHover}"/>
    <SolidColorBrush x:Key="DsTextBrush" Color="{StaticResource DsText}"/>
    <SolidColorBrush x:Key="DsText2Brush" Color="{StaticResource DsText2}"/>
    <SolidColorBrush x:Key="DsTextDisBrush" Color="{StaticResource DsTextDis}"/>
    <SolidColorBrush x:Key="DsAccentBrush" Color="{StaticResource DsAccent}"/>
    <SolidColorBrush x:Key="DsDividerBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DsBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DsWarnBrush" Color="#E0A500"/>
    <SolidColorBrush x:Key="DsCloseHoverBrush" Color="#E81123"/>

    <FontFamily x:Key="DsFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="DsMono">Consolas</FontFamily>

    <!-- ============ ÍCONES (outline 24px, traço técnico) ============ -->
    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{StaticResource DsText2Brush}"/>
    </Style>
    <Style x:Key="RowIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stroke" Value="{StaticResource DsText2Brush}"/>
    </Style>

    <Geometry x:Key="G_Dash">M4 7h16 M4 12h16 M4 17h16 M14 5.5h4v3h-4z M8 10.5h4v3H8z M15 15.5h4v3h-4z</Geometry>
    <Geometry x:Key="G_Players">M4 5h16v14H4z M10 9.5l6 2.5-6 2.5z</Geometry>
    <Geometry x:Key="G_Keys">M3 7h18v10H3z M7 10.5h1 M11 10.5h1 M15 10.5h1 M7 14h10</Geometry>
    <Geometry x:Key="G_Display">M4 5h16v10H4z M9 19h6 M12 15v4</Geometry>
    <Geometry x:Key="G_Settings">M12 9a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M12 4v2 M12 18v2 M4 12h2 M18 12h2 M6.5 6.5l1.4 1.4 M16.1 16.1l1.4 1.4 M17.5 6.5l-1.4 1.4 M8.4 15.6l-1.4 1.4</Geometry>
    <Geometry x:Key="G_Vol">M4 9.5v5h3.5L12 18V6L7.5 9.5z M15.5 9a4.5 4.5 0 0 1 0 6 M18 6.5a8 8 0 0 1 0 11</Geometry>
    <Geometry x:Key="G_Play">M8 5.5l11 6.5-11 6.5z</Geometry>
    <Geometry x:Key="G_Prev">M7 6v12 M19 6l-9 6 9 6z</Geometry>
    <Geometry x:Key="G_Next">M17 6v12 M5 6l9 6-9 6z</Geometry>
    <Geometry x:Key="G_Shuffle">M3 7h4l10 10h4 M3 7l2.5-2.5M3 7l2.5 2.5 M21 7h-4l-10 10H3 M21 7l-2.5-2.5M21 7l-2.5 2.5 M21 17l-2.5-2.5M21 17l-2.5 2.5 M3 17l2.5-2.5M3 17l2.5 2.5</Geometry>
    <Geometry x:Key="G_Refresh">M19 12a7 7 0 1 1-2-4.9 M17 3.5V8h-4.5</Geometry>
    <Geometry x:Key="G_Warn">M12 4L21 20H3z M12 10v4 M12 17v.5</Geometry>
    <Geometry x:Key="G_Min">M2 12h12</Geometry>
    <Geometry x:Key="G_Max">M3 3h13v13H3z</Geometry>
    <Geometry x:Key="G_Restore">M5 8V5h13v13h-3 M3 11v10h10v-3</Geometry>
    <Geometry x:Key="G_Close">M4 4l12 12M16 4L4 16</Geometry>
    <Geometry x:Key="G_Chevron">M6 9l6 6 6-6</Geometry>
    <Geometry x:Key="G_Check">M5 12.5l4.5 4.5L19 7</Geometry>

    <!-- ============ TIPOGRAFIA ============ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
    </Style>
    <Style x:Key="SectionSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsText2Brush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowDesc" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DsText2Brush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DsText2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DsDividerBrush}"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>

    <!-- ============ BOTÕES ============ -->
    <Style x:Key="BtnDark" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource DsInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#2A2A2A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DsTextDisBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnDark}">
        <Setter Property="Background" Value="{StaticResource DsAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2798F5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#0D72C7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navegação lateral -->
    <Style x:Key="NavToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DsText2Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" Padding="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Bar" Fill="{StaticResource DsAccentBrush}" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" Margin="19,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsSidebarActiveBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões da barra de título -->
    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsCloseHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WinGlyph" TargetType="Path">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Stroke" Value="{StaticResource DsText2Brush}"/>
        <Setter Property="StrokeThickness" Value="1.2"/>
    </Style>

    <!-- ============ COMBOBOX ============ -->
    <Style x:Key="SettingCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource DsInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}" BorderThickness="0" Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,0,34,0">
                                        <Grid>
                                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"/>
                                            <Path Data="{StaticResource G_Chevron}" Width="12" Height="12" Stretch="None"
                                                  Stroke="{StaticResource DsText2Brush}" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,34,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="{StaticResource DsInputBrush}" BorderBrush="{StaticResource DsBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#2E2E2E"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#2E86C1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource DsSidebarActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ CHECKBOX QUADRADO ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource DsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                BorderBrush="#3A3A3A" Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="{StaticResource G_Check}" Width="11" Height="11" Stretch="None"
                                  Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DsAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TOGGLE ============ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#2A2A2A"/>
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{StaticResource DsText2Brush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#333333"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource DsAccentBrush}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TEXTBOX (shortcut input) ============ -->
    <Style x:Key="GestureBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DsMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource DsInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="SelectionBrush" Value="#164A7A"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#2E2E2E"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#2E86C1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SLIDER ============ -->
    <Style x:Key="SettingSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#2C2C2C"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource DsAccentBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource DsAccentBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SCROLLBAR ESCURA ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="5" Margin="3,2" Background="#3A3A3A"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
