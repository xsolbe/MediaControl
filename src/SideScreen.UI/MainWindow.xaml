<Window x:Class="SideScreen.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SideScreen — Fase 2" Height="600" Width="860"
        Background="#070707"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0B0B0B" BorderBrush="#1E1E1E" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,4,0,16">
                    <Ellipse Width="8" Height="8" Fill="#2A2A2A" VerticalAlignment="Center"/>
                    <TextBlock Text="  SideScreen" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>

                <Button Content="Dashboard" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <Button Content="Players" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Players"/>
                <Button Content="Shortcuts" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Shortcuts"/>
                <Button Content="Display" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Display"/>
                <Button Content="Settings" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>

                <TextBlock Text="v0.2.0 · Fase 2" Style="{StaticResource MutedText}" Margin="4,24,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28">
            <StackPanel>
                <TextBlock Text="{Binding SelectedNav}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ContentControl Content="{Binding Current}"/>
                <TextBlock Text="SideScreen 0.2.0 · .NET + WPF · PotPlayer real na Fase 3 · Atalhos reais na Fase 4 · Monitores na Fase 5"
                           Style="{StaticResource MutedText}" Margin="0,24,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
