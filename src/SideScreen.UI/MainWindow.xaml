<Window x:Class="SideScreen.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideScreen.UI"
        mc:Ignorable="d"
        Title="SideScreen — Fase 1" Height="520" Width="720"
        Background="#070707"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#2A2A2A" VerticalAlignment="Center"/>
            <TextBlock Text="  SideScreen" FontSize="18" FontWeight="SemiBold" Foreground="#EDEDED"/>
            <TextBlock Text="  ·  Fase 1 — shell funcionando" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Current Player -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Current Player" Style="{StaticResource MutedText}"/>
                <TextBlock Text="PotPlayer  ·  Offline (stub Fase 1)" FontSize="15" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusText" Text="IsRunning=False — Fase 3 vai detectar via FindWindow."
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Controls placeholder -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Playback Controls (placeholder Fase 2)" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Play/Pause" Width="110" Height="32" Margin="0,0,8,0"/>
                    <Button Content="|◀ Prev" Width="90" Height="32" Margin="0,0,8,0"/>
                    <Button Content="Next ▶|" Width="90" Height="32"/>
                </StackPanel>
                <TextBlock Text="Botões ainda não controlam o PotPlayer. Isso entra na Fase 3 via SendMessage."
                           Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="6" x:Name="FooterText"
                   Text="SideScreen 0.1.0  ·  .NET 10 + WPF  ·  %AppData%\SideScreen\config.json (Fase 6)"
                   Style="{StaticResource MutedText}"/>
    </Grid>
</Window>
