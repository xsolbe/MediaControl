<UserControl x:Class="SideScreen.UI.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Players}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Players" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Select and configure the player" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource G_Display}" Style="{StaticResource RowIcon}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Current player" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource RowLabel}"/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <ItemsControl ItemsSource="{Binding Available}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource G_Play}" Style="{StaticResource RowIcon}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Width="90" VerticalAlignment="Center"
                                    Command="{Binding DataContext.SelectPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnDark}">
                                        <Setter Property="Content" Value="Usar"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                <Setter Property="Content" Value="Em breve"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="MPC-HC entra como um novo IPlayerController, sem tocar no Dashboard. Ver docs/architecture.md."
                   Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
