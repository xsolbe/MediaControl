<UserControl x:Class="SideScreen.UI.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Players" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Selecione qual player será controlado. Só PotPlayer é real na v1." Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding Available}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="30"/>
            <TextBlock Text="{Binding Selected.Status}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            <TextBlock Text="Para adicionar MPC-HC: criar MpcHcController : IPlayerController (sem mexer no Dashboard)." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
