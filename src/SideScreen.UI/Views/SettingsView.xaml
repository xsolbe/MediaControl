<UserControl x:Class="SideScreen.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Settings}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="App, runtime and storage" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Version" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource ValueText}"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Runtime" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Runtime}" Style="{StaticResource ValueText}"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Config file" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" Style="{StaticResource ValueText}" FontSize="11"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="What this utility does" Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <TextBlock Text="{Binding About}" Style="{StaticResource MutedText}"/>
    </StackPanel>
</UserControl>
