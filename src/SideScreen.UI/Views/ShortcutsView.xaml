<UserControl x:Class="SideScreen.UI.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Keys}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Click a field and press the combination" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource RowDesc}"/>
                                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource DsWarnBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding Warning, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource GestureBox}" VerticalAlignment="Center"
                                     PreviewKeyDown="GestureBox_PreviewKeyDown" ToolTip="Clique e pressione o combo"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Section: Behavior -->
        <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="When global hotkeys are allowed to fire" Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Enable global hotkeys" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Opt-in. Off = control only from Dashboard buttons." Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableGlobal}" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Guard" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="OnlyListed fires only in the processes below." Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                      ItemsSource="{Binding GuardModes}" SelectedItem="{Binding SelectedGuardMode}" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Double-press Next → Previous" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Experimental: single Next waits ~350ms." Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Text="{Binding DoublePressWindowMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource GestureBox}" Width="64" Margin="0,0,10,0" ToolTip="Janela em ms (200-500)"/>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DoublePressEnabled}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <!-- Section: Process scope -->
        <TextBlock Text="Process scope" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="Used when Guard = OnlyListed. Empty list blocks everything." Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Running programs" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Tick where hotkeys may fire." Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Atualizar lista" Style="{StaticResource BtnDark}"
                    Command="{Binding RefreshProcessesCommand}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Apply" Style="{StaticResource BtnPrimary}" Command="{Binding ApplyCommand}" Width="110"/>
            <Button Content="Restaurar padrões" Style="{StaticResource BtnDark}" Command="{Binding RestoreDefaultsCommand}" Width="150" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Path Data="{StaticResource G_Warn}" Style="{StaticResource RowIcon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"/>
            <TextBlock Text="Global hotkeys fire with the game focused and may double-trigger keys there (F1/F2 also reach BNSR). Check game bindings before ranked."
                       Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource MutedText}" FontFamily="{StaticResource DsMono}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
