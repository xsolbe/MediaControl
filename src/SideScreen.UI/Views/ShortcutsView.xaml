<UserControl x:Class="SideScreen.UI.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Keys}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="{DynamicResource S_ShortcutsTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource S_ShortcutsSub}" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource RowDesc}"/>
                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource DsWarnBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding Warning, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource GestureBox}" VerticalAlignment="Center"
                                     PreviewKeyDown="GestureBox_PreviewKeyDown"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Section: Behavior -->
        <TextBlock Text="{DynamicResource S_Behavior}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="{DynamicResource S_BehaviorSub}" Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_EnableGlobal}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_EnableGlobalDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableGlobal}" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_Guard}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_GuardDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                      ItemsSource="{Binding GuardModes}" SelectedItem="{Binding SelectedGuardMode}" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_DoublePress}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_DoublePressDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_WindowMs}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DoublePressWindowMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource GestureBox}" Width="64" Margin="8,0,10,0"/>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DoublePressEnabled}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <!-- Section: Process scope -->
        <TextBlock Text="{DynamicResource S_ProcessScope}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="{DynamicResource S_ProcessScopeSub}" Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_RunningPrograms}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_RunningProgramsDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource S_RefreshList}" Style="{StaticResource BtnDark}"
                    Command="{Binding RefreshProcessesCommand}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{DynamicResource S_Apply}" Style="{StaticResource BtnPrimary}" Command="{Binding ApplyCommand}" Width="110"/>
            <Button Content="{DynamicResource S_Restore}" Style="{StaticResource BtnDark}" Command="{Binding RestoreDefaultsCommand}" Width="150" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Path Data="{StaticResource G_Warn}" Style="{StaticResource RowIcon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"/>
            <TextBlock Text="{DynamicResource S_Disclaimer}"
                       Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource MutedText}" FontFamily="{StaticResource DsMono}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
