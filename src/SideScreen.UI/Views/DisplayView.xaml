<UserControl x:Class="SideScreen.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Display}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Player Position" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Where the player lives" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Monitor" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Detected live via EnumDisplayMonitors." Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                      ItemsSource="{Binding Monitors}" SelectedItem="{Binding Selected}"
                      DisplayMemberPath="Label" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
