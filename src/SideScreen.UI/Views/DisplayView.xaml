<UserControl x:Class="SideScreen.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Player Position" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
            <ComboBox ItemsSource="{Binding Monitors}" SelectedIndex="{Binding SelectedMonitor}" Height="30"/>
            <CheckBox IsChecked="{Binding LockPlayer}" Content="Lock player to selected monitor" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
