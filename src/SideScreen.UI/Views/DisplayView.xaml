<UserControl x:Class="SideScreen.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Monitores detectados" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" Height="30"/>
            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
    </Border>
</UserControl>
