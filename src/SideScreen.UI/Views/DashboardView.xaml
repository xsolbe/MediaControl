<UserControl x:Class="SideScreen.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Current Player" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding PlayerName}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding PlayerState}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Playback Controls" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Play/Pause" Command="{Binding PlayPauseCommand}" Width="110" Height="32" Margin="0,0,8,0"/>
                    <Button Content="|◀ Prev" Command="{Binding PreviousCommand}" Width="90" Height="32" Margin="0,0,8,0"/>
                    <Button Content="Next ▶|" Command="{Binding NextCommand}" Width="90" Height="32"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Volume" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Slider Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" Width="280" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding Shuffle}" Content="Shuffle" VerticalAlignment="Center"/>
                <TextBlock Text="  Nativo do player (Fase 3)" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Player Status" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
