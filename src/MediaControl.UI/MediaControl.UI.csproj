<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MediaControl.Core\MediaControl.Core.csproj" />
    <ProjectReference Include="..\MediaControl.Infrastructure\MediaControl.Infrastructure.csproj" />
  </ItemGroup>

  <!-- WinForms só pelo Screen; remove usings implícitos p/ não colidir com WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Nome do produto: o .exe sai como MediaControl.exe. Namespaces seguem MediaControl.* (invisível). -->
    <AssemblyName>MediaControl</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms só para Screen (work area no maximizado). UI continua 100% WPF. -->
  </PropertyGroup>

</Project>
