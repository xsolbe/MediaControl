<UserControl x:Class="MediaControl.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource G_Settings}" Style="{StaticResource RowIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="{DynamicResource S_SettingsTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource S_SettingsSub}" Style="{StaticResource SectionSub}"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_Appearance}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_AppearanceDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                      ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                      SelectedValue="{Binding Appearance}" SelectedValuePath="Id" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_Language}" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{DynamicResource S_LanguageDesc}" Style="{StaticResource RowDesc}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                      ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                      SelectedValue="{Binding Language}" SelectedValuePath="Id" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource S_Version}" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource ValueText}"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource S_Runtime}" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Runtime}" Style="{StaticResource ValueText}"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <Grid MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource S_ConfigFile}" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" Style="{StaticResource ValueText}" FontSize="11"/>
        </Grid>
        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="{DynamicResource S_AboutTitle}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
        <TextBlock Text="{DynamicResource S_AboutSub}" Style="{StaticResource SectionSub}"/>
        <Border Style="{StaticResource Divider}" Margin="0,16,0,8"/>

        <TextBlock Text="{DynamicResource S_AboutText}" Style="{StaticResource MutedText}"/>
    </StackPanel>
</UserControl>
