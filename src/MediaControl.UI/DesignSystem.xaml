<!-- MediaControl Design System v1 — dark utilitário Windows. Sem neon, sem cards, sem gradiente. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores/brushes vivem em Theme.Dark.xaml / Theme.Light.xaml (troca ao vivo).
         Aqui tudo referencia brush via DynamicResource. -->
    <FontFamily x:Key="DsFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="DsMono">Consolas</FontFamily>

    <!-- ============ ÍCONES (outline 24px, traço técnico) ============ -->
    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource DsText2Brush}"/>
    </Style>
    <Style x:Key="RowIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>

    <!-- Lucide (ISC) — monitor-play, keyboard, monitor, settings, sliders-horizontal etc. -->
    <Geometry x:Key="G_Dash">M10 5H3 M12 19H3 M14 3v4 M16 17v4 M21 12h-9 M21 19h-5 M21 5h-7 M8 10v4 M8 12H3</Geometry>
