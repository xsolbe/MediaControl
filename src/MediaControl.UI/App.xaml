<Application x:Class="MediaControl.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaControl.UI"
             xmlns:vm="clr-namespace:MediaControl.UI.ViewModels"
             xmlns:views="clr-namespace:MediaControl.UI.Views"
             xmlns:conv="clr-namespace:MediaControl.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ordem fixa: 0 tema, 1 idioma, 2 design (services trocam por índice). -->
                <ResourceDictionary Source="Theme.Dark.xaml"/>
                <ResourceDictionary Source="Localization/Strings.en.xaml"/>
                <ResourceDictionary Source="DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- ViewModel -> View (navegação automática) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
                <views:PlayersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}">
                <views:ShortcutsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                <views:DisplayView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
